{
  // Cloudflare Workers deploy config. Deploy: npm run deploy (after `npx wrangler login`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devmeet-mvp",
  "main": "dist/cloudflare/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node scripts/build-cloudflare.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "devmeet-mvp", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "drizzle" }
  ],
  "r2_buckets": [
    { "binding": "BUCKET", "bucket_name": "devmeet-mvp-photos" }
  ],
  "observability": { "enabled": true }
}
