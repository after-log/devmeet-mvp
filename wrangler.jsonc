{
  // Cloudflare Workers deploy config. Deploy: npm run deploy (after `npx wrangler login`).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "devmeet-mvp",
  "main": "dist/cloudflare/index.js",
  "compatibility_date": "2026-10-01",
  "build": { "command": "node scripts/build-cloudflare.mjs" },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "devmeet-mvp", "database_id": "e30c463c-1dd6-40a5-9d16-5492b58cc0c8", "migrations_dir": "drizzle" }
  ],
  "observability": { "enabled": true }
}
